NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY
# E-mails autorizados no painel /admin, separados por vírgula (somente servidor).
ADMIN_EMAILS=voce@exemplo.com
# NÃO coloque a SERVICE_ROLE_KEY no frontend.
# Se no futuro precisar de operações administrativas privilegiadas,
# use uma variável sem NEXT_PUBLIC_ somente no servidor.

# ===== V4 — somente servidor (NUNCA com NEXT_PUBLIC_) =====
# Supabase privilegiado (cron/worker + rotas admin server-only).
SUPABASE_SERVICE_ROLE_KEY=...
# Mercado Livre — app oficial (https://developers.mercadolivre.com.br → Criar app).
# A API do ML exige access token; com ID+SECRET o servidor obtém sozinho.
ML_CLIENT_ID=...
ML_CLIENT_SECRET=...
# Opcional: se preferir colar um token pronto (dura ~6h).
# ML_ACCESS_TOKEN=...
# Shopee Affiliate Open API (https://open.shopee.com) — server-only.
SHOPEE_APP_ID=...
SHOPEE_APP_SECRET=...
# Base da API Shopee (opcional; default https://open-api.affiliate.shopee.com.br).
# SHOPEE_API_BASE=https://open-api.affiliate.shopee.com.br
# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp) — server-only.
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_PHONE_ID=...
# WHATSAPP_TEST_TO=5511999999999
# Template aprovado p/ iniciar conversa fora da janela de 24h (categoria Marketing).
# Crie em Gerenciador do WhatsApp → Ferramentas da conta → Modelos e cole o nome exato.
# WHATSAPP_TEMPLATE_OFERTA=achadinho_oferta
# Automação V4 (cron/worker).
CRON_SECRET=gere-um-token-longo-aleatorio
# Termos padrão do cron separados por vírgula (opcional).
# CRON_TERMOS=air fryer,fone bluetooth,aspirador robô
# Publicação automática? Padrão false. Mesmo com true, sem affiliate oficial continua pending.
# ALLOW_AUTO_PUBLISH=false
# Google Search Console (verificação via meta tag).
# Pegue o código em search.google.com/search-console → Adicionar propriedade.
# GOOGLE_SITE_VERIFICATION=abc123...
